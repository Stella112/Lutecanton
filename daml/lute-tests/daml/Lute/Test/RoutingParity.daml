module Lute.Test.RoutingParity where

import Daml.Script
import Lute.Routing
import Lute.Types

check : Text -> RoutingInput -> Optional Route -> Optional BlockedReason -> Decimal -> Decimal -> Decimal -> Decimal -> Script ()
check name i route reason cashUsed shortfall redeem remaining =
  case computeFundingRoute i of
    Left err -> abort (name <> ": unexpected input error: " <> err)
    Right r -> do
      assertMsg (name <> ": route " <> show r.route) (r.route == route)
      assertMsg (name <> ": blockedReason " <> show r.blockedReason) (r.blockedReason == reason)
      assertMsg (name <> ": cashUsed " <> show r.cashUsed) (r.cashUsed == cashUsed)
      assertMsg (name <> ": shortfall " <> show r.shortfall) (r.shortfall == shortfall)
      assertMsg (name <> ": redeemAmount " <> show r.redeemAmount) (r.redeemAmount == redeem)
      assertMsg (name <> ": remainingProductive " <> show r.remainingProductive) (r.remainingProductive == remaining)

testRoutingParity : Script ()
testRoutingParity = do
  check "S1 happy path: 20k cash, 15k RWA, 24.8k payroll"
    RoutingInput with
      cash = 20000.0
      productive = 15000.0
      redeemable = 15000.0
      obligation = 24800.0
      policy = RoutingPolicy with
        minCashBuffer = 0.0
        maxRedeemPerExecution = None
        allowedRoutes = [CashOnly, CashThenRedeem]
    (Some CashThenRedeem) None
    20000.0 4800.0 4800.0 10200.0
  check "cash > obligation"
    RoutingInput with
      cash = 30000.0
      productive = 15000.0
      redeemable = 15000.0
      obligation = 24800.0
      policy = RoutingPolicy with
        minCashBuffer = 0.0
        maxRedeemPerExecution = None
        allowedRoutes = [CashOnly, CashThenRedeem]
    (Some CashOnly) None
    24800.0 0.0 0.0 15000.0
  check "cash = obligation"
    RoutingInput with
      cash = 24800.0
      productive = 15000.0
      redeemable = 15000.0
      obligation = 24800.0
      policy = RoutingPolicy with
        minCashBuffer = 0.0
        maxRedeemPerExecution = None
        allowedRoutes = [CashOnly, CashThenRedeem]
    (Some CashOnly) None
    24800.0 0.0 0.0 15000.0
  check "cash = 0, fully redeemed from productive"
    RoutingInput with
      cash = 0.0
      productive = 15000.0
      redeemable = 15000.0
      obligation = 9000.0
      policy = RoutingPolicy with
        minCashBuffer = 0.0
        maxRedeemPerExecution = None
        allowedRoutes = [CashOnly, CashThenRedeem]
    (Some CashThenRedeem) None
    0.0 9000.0 9000.0 6000.0
  check "productive = 0, cash covers"
    RoutingInput with
      cash = 10000.0
      productive = 0.0
      redeemable = 0.0
      obligation = 5000.0
      policy = RoutingPolicy with
        minCashBuffer = 0.0
        maxRedeemPerExecution = None
        allowedRoutes = [CashOnly, CashThenRedeem]
    (Some CashOnly) None
    5000.0 0.0 0.0 0.0
  check "productive = 0, cash short"
    RoutingInput with
      cash = 1000.0
      productive = 0.0
      redeemable = 0.0
      obligation = 5000.0
      policy = RoutingPolicy with
        minCashBuffer = 0.0
        maxRedeemPerExecution = None
        allowedRoutes = [CashOnly, CashThenRedeem]
    None (Some InsufficientLiquidity)
    1000.0 4000.0 0.0 0.0
  check "exact total: cash + productive = obligation"
    RoutingInput with
      cash = 20000.0
      productive = 15000.0
      redeemable = 15000.0
