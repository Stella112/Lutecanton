{
  "_comment": "Shared routing fixtures. Consumed by the TS router tests and by scripts/gen-daml-routing-cases.mjs, which emits identical Daml Script tests. Any disagreement between backend and ledger is a blocker (spec §47).",
  "defaultPolicy": { "minCashBuffer": "0", "maxRedeemPerExecution": null, "allowedRoutes": ["CashOnly", "CashThenRedeem"] },
  "cases": [
    { "name": "S1 happy path: 20k cash, 15k RWA, 24.8k payroll",
      "input": { "cash": "20000", "productive": "15000", "obligation": "24800" },
      "expect": { "route": "CashThenRedeem", "cashUsed": "20000", "shortfall": "4800", "redeemAmount": "4800", "remainingProductive": "10200" } },
    { "name": "cash > obligation",
      "input": { "cash": "30000", "productive": "15000", "obligation": "24800" },
      "expect": { "route": "CashOnly", "cashUsed": "24800", "shortfall": "0", "redeemAmount": "0", "remainingProductive": "15000" } },
    { "name": "cash = obligation",
      "input": { "cash": "24800", "productive": "15000", "obligation": "24800" },
      "expect": { "route": "CashOnly", "cashUsed": "24800", "shortfall": "0", "redeemAmount": "0", "remainingProductive": "15000" } },
    { "name": "cash = 0, fully redeemed from productive",
      "input": { "cash": "0", "productive": "15000", "obligation": "9000" },
      "expect": { "route": "CashThenRedeem", "cashUsed": "0", "shortfall": "9000", "redeemAmount": "9000", "remainingProductive": "6000" } },
    { "name": "productive = 0, cash covers",
      "input": { "cash": "10000", "productive": "0", "obligation": "5000" },
      "expect": { "route": "CashOnly", "cashUsed": "5000", "shortfall": "0", "redeemAmount": "0", "remainingProductive": "0" } },
    { "name": "productive = 0, cash short",
      "input": { "cash": "1000", "productive": "0", "obligation": "5000" },
      "expect": { "route": null, "blockedReason": "INSUFFICIENT_LIQUIDITY", "cashUsed": "1000", "shortfall": "4000", "redeemAmount": "0", "remainingProductive": "0" } },
    { "name": "exact total: cash + productive = obligation",
      "input": { "cash": "20000", "productive": "15000", "obligation": "35000" },
      "expect": { "route": "CashThenRedeem", "cashUsed": "20000", "shortfall": "15000", "redeemAmount": "15000", "remainingProductive": "0" } },
    { "name": "S8 insufficient treasury",
      "input": { "cash": "2000", "productive": "3000", "obligation": "10000" },
      "expect": { "route": null, "blockedReason": "INSUFFICIENT_LIQUIDITY", "cashUsed": "2000", "shortfall": "8000", "redeemAmount": "0", "remainingProductive": "3000" } },
    { "name": "redeemable < productive limits funding",
      "input": { "cash": "20000", "productive": "15000", "redeemable": "4000", "obligation": "24800" },
      "expect": { "route": null, "blockedReason": "INSUFFICIENT_LIQUIDITY", "cashUsed": "20000", "shortfall": "4800", "redeemAmount": "0", "remainingProductive": "15000" } },
    { "name": "redeemable exactly covers shortfall",
      "input": { "cash": "20000", "productive": "15000", "redeemable": "4800", "obligation": "24800" },
      "expect": { "route": "CashThenRedeem", "cashUsed": "20000", "shortfall": "4800", "redeemAmount": "4800", "remainingProductive": "10200" } },
    { "name": "cash buffer increases redemption",
      "input": { "cash": "20000", "productive": "15000", "obligation": "24800", "policy": { "minCashBuffer": "1000" } },
      "expect": { "route": "CashThenRedeem", "cashUsed": "19000", "shortfall": "5800", "redeemAmount": "5800", "remainingProductive": "9200" } },
    { "name": "cash buffer larger than cash",
      "input": { "cash": "500", "productive": "15000", "obligation": "2000", "policy": { "minCashBuffer": "1000" } },
      "expect": { "route": "CashThenRedeem", "cashUsed": "0", "shortfall": "2000", "redeemAmount": "2000", "remainingProductive": "13000" } },
    { "name": "cash buffer turns cash-only into redemption",
      "input": { "cash": "25000", "productive": "15000", "obligation": "24800", "policy": { "minCashBuffer": "1000" } },
      "expect": { "route": "CashThenRedeem", "cashUsed": "24000", "shortfall": "800", "redeemAmount": "800", "remainingProductive": "14200" } },
    { "name": "redemption cap respected (equal)",
      "input": { "cash": "20000", "productive": "15000", "obligation": "24800", "policy": { "maxRedeemPerExecution": "4800" } },
      "expect": { "route": "CashThenRedeem", "cashUsed": "20000", "shortfall": "4800", "redeemAmount": "4800", "remainingProductive": "10200" } },
    { "name": "redemption cap exceeded",
      "input": { "cash": "20000", "productive": "15000", "obligation": "24800", "policy": { "maxRedeemPerExecution": "4799.9999999999" } },
      "expect": { "route": null, "blockedReason": "REDEMPTION_CAP_EXCEEDED", "cashUsed": "20000", "shortfall": "4800", "redeemAmount": "0", "remainingProductive": "15000" } },
    { "name": "redemption needed but route not allowed",
      "input": { "cash": "20000", "productive": "15000", "obligation": "24800", "policy": { "allowedRoutes": ["CashOnly"] } },
      "expect": { "route": null, "blockedReason": "ROUTE_NOT_ALLOWED", "cashUsed": "20000", "shortfall": "4800", "redeemAmount": "0", "remainingProductive": "15000" } },
    { "name": "cash-only needed but only redeem route allowed",
      "input": { "cash": "30000", "productive": "15000", "obligation": "24800", "policy": { "allowedRoutes": ["CashThenRedeem"] } },
      "expect": { "route": null, "blockedReason": "ROUTE_NOT_ALLOWED", "cashUsed": "24800", "shortfall": "0", "redeemAmount": "0", "remainingProductive": "15000" } },
    { "name": "zero obligation blocked",
      "input": { "cash": "20000", "productive": "15000", "obligation": "0" },
      "expect": { "route": null, "blockedReason": "ZERO_OBLIGATION", "cashUsed": "0", "shortfall": "0", "redeemAmount": "0", "remainingProductive": "15000" } },
    { "name": "fractional amounts are exact (no float drift)",
      "input": { "cash": "0.1", "productive": "10", "obligation": "0.3" },
      "expect": { "route": "CashThenRedeem", "cashUsed": "0.1", "shortfall": "0.2", "redeemAmount": "0.2", "remainingProductive": "9.8" } },
    { "name": "smallest unit boundary",
      "input": { "cash": "24799.9999999999", "productive": "15000", "obligation": "24800" },
      "expect": { "route": "CashThenRedeem", "cashUsed": "24799.9999999999", "shortfall": "0.0000000001", "redeemAmount": "0.0000000001", "remainingProductive": "14999.9999999999" } },
    { "name": "large decimals beyond JS Number precision",
      "input": { "cash": "90071992547409930000.5", "productive": "1000000000000000000000", "obligation": "100071992547409930000.75" },
      "expect": { "route": "CashThenRedeem", "cashUsed": "90071992547409930000.5", "shortfall": "10000000000000000000.25", "redeemAmount": "10000000000000000000.25", "remainingProductive": "989999999999999999999.75" } }
  ]
}
